<ueberschrift typ="titel" halign="j">Abkürzung</ueberschrift><absatz typ="erltext" ct="abkuerzung" halign="j">NISG 2026</absatz><ueberschrift typ="titel" halign="j">Index</ueberschrift><absatz typ="erltext" ct="index" halign="j">41/01 Sicherheitsrecht</absatz><ueberschrift typ="titel" halign="j">Text</ueberschrift><ueberschrift typ="g1" ct="text" halign="c">2. Hauptstück</ueberschrift><ueberschrift typ="g2" ct="text" halign="c">Strukturen und Aufgaben</ueberschrift><ueberschrift typ="g1min" ct="text" halign="c">1. Abschnitt</ueberschrift><ueberschrift typ="g2" ct="text" halign="c">Zuständige Behörde</ueberschrift><ueberschrift typ="para" ct="text" halign="c">Bundesamt für Cybersicherheit</ueberschrift><absatz typ="abs" ct="text" halign="j"><gldsym>§ 3a.</gldsym> (1) Zuständige Behörde im Sinne dieses Bundesgesetzes ist das Bundesamt für Cybersicherheit (Cybersicherheitsbehörde).</absatz><absatz typ="abs" ct="text" halign="j">(2) Die Cybersicherheitsbehörde besteht als eine dem Bundesminister für Inneres unmittelbar nachgeordnete organisatorisch außerhalb der Generaldirektion für die öffentliche Sicherheit eingerichtete Behörde mit bundesweiter Zuständigkeit.</absatz><absatz typ="abs" ct="text" halign="j">(3) Der Direktor sowie sein Stellvertreter haben den zuständigen Ausschüssen des Nationalrats für Auskünfte aus ihrem Aufgabenbereich zur Verfügung zu stehen.</absatz><ueberschrift typ="titel" halign="j">Zuletzt aktualisiert am</ueberschrift><absatz typ="erltext" ct="geaendert" halign="j">30.12.2025</absatz><ueberschrift typ="titel" halign="j">Gesetzesnummer</ueberschrift><absatz typ="erltext" ct="gesnr" halign="j">20013065</absatz><ueberschrift typ="titel" halign="j">Dokumentnummer</ueberschrift><absatz typ="erltext" ct="doknr" halign="j">NOR40273863</absatz></abschnitt></nutzdaten><layoutdaten paperf="7" paperh="841.95" paperw="595.35" margl="85.05" margr="85.05" margt="85.05" margb="85.05" headerd="28.35" footerd="65.2" gutter="0" gutterpos="0" deftab="35.4" /></