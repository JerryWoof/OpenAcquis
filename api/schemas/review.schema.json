{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerrywoof.github.io/OpenAcquis/api/v1/schemas/review.schema.json",
  "title": "Review record",
  "description": "One reviewer's verdict on one machine suggestion (openacquis.review, schema 1). Same fields as openacquis.review.FIELDS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suggestion_id",
    "directive",
    "country",
    "kind",
    "eu_id",
    "national_id",
    "machine",
    "verdict",
    "corrected_ids",
    "reviewer",
    "date",
    "note"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "suggestion_id": {
      "$ref": "common.schema.json#/$defs/suggestion_id"
    },
    "directive": {
      "$ref": "common.schema.json#/$defs/celex"
    },
    "country": {
      "$ref": "common.schema.json#/$defs/cc"
    },
    "kind": {
      "enum": [
        "link",
        "gap",
        "extra_rule"
      ]
    },
    "eu_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/eu_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "national_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/national_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "machine": {
      "type": "object",
      "required": [],
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "confirm",
        "reject",
        "correct"
      ]
    },
    "corrected_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
